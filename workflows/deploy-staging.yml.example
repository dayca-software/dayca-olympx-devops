name: OlympX Deploy Staging

on:
  workflow_dispatch:

permissions:
  contents: read
  id-token: write

concurrency:
  group: olympx-staging-deploy
  cancel-in-progress: false

env:
  AWS_REGION: ${{ vars.AWS_REGION }}
  ECR_REPOSITORY: ${{ vars.ECR_REPOSITORY }}
  ECS_EXPRESS_SERVICE_ARN: ${{ vars.ECS_EXPRESS_SERVICE_ARN }}

jobs:
  deploy:
    name: Build and deploy API to ECS Express Mode Staging
    if: github.ref == 'refs/heads/staging'
    runs-on: ubuntu-latest
    environment: staging

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          path: olympx-api

      - name: Checkout shared contracts
        uses: actions/checkout@v4
        with:
          repository: dayca-software/dayca-olympx-contracts
          ref: main
          token: ${{ secrets.CONTRACTS_READ_TOKEN || github.token }}
          path: olympx-contracts

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 11.9.0

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22

      - name: Prepare workspace build context
        run: |
          set -euo pipefail
          cat > package.json <<'EOF'
          {"private":true,"packageManager":"pnpm@11.9.0"}
          EOF
          cat > pnpm-workspace.yaml <<'EOF'
          packages:
            - "olympx-api"
            - "olympx-contracts"
          EOF
          pnpm install --lockfile-only --ignore-scripts

      - name: Configure AWS credentials with OIDC
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-region: ${{ env.AWS_REGION }}
          role-to-assume: ${{ secrets.AWS_ROLE_TO_ASSUME }}

      - name: Login to ECR
        id: ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build and push immutable image
        env:
          REGISTRY: ${{ steps.ecr.outputs.registry }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          set -euo pipefail
          image="${REGISTRY}/${ECR_REPOSITORY}"
          docker build -f olympx-api/Dockerfile -t "${image}:${IMAGE_TAG}" .
          docker push "${image}:${IMAGE_TAG}"
          docker tag "${image}:${IMAGE_TAG}" "${image}:staging"
          docker push "${image}:staging"

      - name: Update ECS Express Mode service
        run: |
          set -euo pipefail
          image="${{ steps.ecr.outputs.registry }}/${ECR_REPOSITORY}"
          digest="$(aws ecr describe-images \
            --repository-name "${ECR_REPOSITORY}" \
            --image-ids imageTag="${{ github.sha }}" \
            --query 'imageDetails[0].imageDigest' \
            --output text)"
          aws ecs update-express-gateway-service \
            --service-arn "${ECS_EXPRESS_SERVICE_ARN}" \
            --primary-container "image=${image}@${digest}" \
            --monitor-resources DEPLOYMENT \
            --monitor-mode TEXT-ONLY

      - name: Smoke health endpoint
        run: |
          set -euo pipefail
          service_url="$(aws ecs describe-express-gateway-service \
            --service-arn "${ECS_EXPRESS_SERVICE_ARN}" \
            --query 'service.activeConfigurations[0].ingressPaths[0].endpoint' \
            --output text)"
          curl --fail --silent --show-error "${service_url}/api/health"
