name: OlympX CI

on:
  pull_request:
  push:
    branches:
      - main
      - develop

permissions:
  contents: read

jobs:
  api:
    name: API checks
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 11.9.0

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Install API dependencies
        run: pnpm install --frozen-lockfile --filter olympx-api...

      - name: Validate Prisma
        run: pnpm --filter olympx-api exec prisma validate

      - name: Typecheck API
        run: pnpm --filter olympx-api typecheck

      - name: Test API
        run: pnpm --filter olympx-api test

      - name: Build API
        run: pnpm --filter olympx-api build

      - name: Build Docker image
        run: docker build -f olympx-api/Dockerfile -t olympx-api:ci .
